.TH _printf 3 "17 April 2026" "1.0" "_printf man page"
.SH NAME
_printf \- print formatted output to stdout
.SH SYNOPSIS
.B #include "main.h"
.br
.B int _printf(const char *format, ...);
.SH DESCRIPTION
The _printf() function writes output to stdout under the control of a format string.
.SH CONVERSION SPECIFIERS
.TP
.B %c
Prints a single character.
.TP
.B %s
Prints a string.
.TP
.B %d, %i
Prints a signed decimal integer.
.TP
.B %u
Prints an unsigned decimal integer.
.TP
.B %o
Prints an unsigned octal.
.TP
.B %x
Prints unsigned hexadecimal (lowercase).
.TP
.B %X
Prints unsigned hexadecimal (uppercase).
.TP
.B %b
Prints unsigned int in binary.
.TP
.B %p
Prints pointer address.
.TP
.B %%
Prints a literal percent sign.
.SH RETURN VALUE
Returns the number of characters printed, or -1 on error.
.SH EXAMPLE
.nf
#include "main.h"

int main(void)
{
    _printf("Hello, %s!\n", "World");
    _printf("Number: %d\n", 42);
    return (0);
}
.fi
.SH SEE ALSO
printf(3)
